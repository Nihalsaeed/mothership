---
import Base from "../layouts/Base.astro";
import { getCollection } from "astro:content";
import seats from "../content/house/seats.json";

const crew = (await getCollection("crew")).sort(
  (a, b) => a.data.order - b.data.order,
);
const roster = [...seats].sort();
---
<Base title="The house" description="Who keeps the doors and who has a seat.">
  <h1>The house</h1>

  <p>
    Not a corporate “meet the team” page. This is who holds keys and who has a
    room. Maintainers keep the fabric standing. Residents have a guest under
    their name. Notes authors show up when they write ->
    <a href="/authors/">authors</a>.
  </p>

  <h2>Crew</h2>
  <p class="note">
    People who touch metal, edge, and the brochure. Source:
    <code>sites/tharavad/src/content/crew/</code>.
  </p>
  <ul>
    {
      crew.map((person) => (
        <li>
          <strong>{person.data.name}</strong>
          <span class="note"> · {person.data.role}</span>
          {person.data.links.length > 0 && (
            <span class="note">
              {" "}
              ·{" "}
              {person.data.links.map((link, i) => (
                <>
                  {i > 0 && " · "}
                  <a href={link.href}>{link.label}</a>
                </>
              ))}
            </span>
          )}
        </li>
      ))
    }
  </ul>

  <h2>Residents</h2>
  <p class="note">
    everyone with a machine. read live from <code>user-vms/</code> on every
    deploy. join and you show up here. nobody updates this by hand.
  </p>
  <ul id="residents">
    {
      roster.map((name) => (
        <li>
          <code>{name}</code>
          <span class="note">
            {" "}
            · <code>ssh {name}@{name}.tharavad.xyz</code>
          </span>
        </li>
      ))
    }
  </ul>

  <script is:inline>
    // /house/seats.json is generated by nix from user-vms/ (modules/landing.nix).
    // the list above is the build-time fallback.
    fetch("/house/seats.json")
      .then((r) => (r.ok ? r.json() : Promise.reject()))
      .then((names) => {
        const ul = document.getElementById("residents");
        ul.replaceChildren(
          ...names.sort().map((name) => {
            const li = document.createElement("li");
            const code = document.createElement("code");
            code.textContent = name;
            const note = document.createElement("span");
            note.className = "note";
            note.append(" · ");
            const ssh = document.createElement("code");
            ssh.textContent = `ssh ${name}@${name}.tharavad.xyz`;
            note.append(ssh);
            li.append(code, note);
            return li;
          }),
        );
      })
      .catch(() => {});
  </script>

  <p>
    Want a seat? <a href="/join/">Join</a>. What changed lately?
    <a href="/log/">Ship log</a>.
  </p>
</Base>
